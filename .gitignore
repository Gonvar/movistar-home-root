# build outputs (harnesses/build.sh compiles every harnesses/*.c to a
# same-named binary + a .gz; list the binaries explicitly so a stray
# source file can't produce a tracked executable, but cover the .gz
# with a wildcard so new harnesses don't need a second entry here)
*.o
*.a
*.gz
